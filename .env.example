# Copy to .env (or set these in your host's dashboard). Nothing here is a real secret.
# The server reads real environment variables; load this file with `node --env-file=.env server/index.js`
# or let Docker Compose do it (see docker-compose.yml).

PORT=3000
# Where the SQLite file is stored. Mount a persistent disk or volume here in production.
DATABASE_PATH=data/ember-oak.db

# true  = load the sample catalogue, 22 sample orders and two demo accounts into an empty database,
#         and allow the admin "Restore demo data" button. Use for the live demo.
# false = start with an empty store and create one admin from the two variables below.
DEMO_MODE=true

# Used only when DEMO_MODE=false and the database has no users yet.
ADMIN_EMAIL=owner@your-domain.example
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Set to true when the app is behind HTTPS (the session cookie is then marked Secure).
# Hosts that send X-Forwarded-Proto: https (Render, Railway, Fly, most proxies) are detected automatically.
COOKIE_SECURE=false
# Set to true behind a reverse proxy so login rate limits use the real client IP.
TRUST_PROXY=false
# Serverless demo hosting only (set automatically by api/[...path].js on Vercel). Optional signing secret.
STATELESS_SESSIONS=false
SESSION_SECRET=
# Extra browser origins allowed to call the API (comma separated). Normally empty.
ALLOWED_ORIGINS=
