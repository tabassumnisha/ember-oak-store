# Copy to .env at the project root (or set these in your host's dashboard). Nothing here is a real secret.
# The server reads real environment variables. From the project root run:
#   cd "Node API" && node --env-file=../.env server/index.js
# Docker Compose reads .env by itself (see docker-compose.yml).
# DATABASE_PATH below is relative to the folder you start the server from ("Node API").

PORT=3000
# Where the SQLite file is stored. Mount a persistent disk or volume here in production.
DATABASE_PATH=data/ember-oak.db

# false = SAFE DEFAULT. Start with an empty store and create one admin from the two variables below.
# true  = DEMO ONLY: load the sample catalogue, 22 sample orders and two demo accounts, show the demo logins
#         on the sign-in page and allow the admin "Restore demo data" button. Never use on a real store.
DEMO_MODE=false

# Used only when DEMO_MODE=false and the database has no users yet.
ADMIN_EMAIL=owner@your-domain.example
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Set to true when the app is behind HTTPS (the session cookie is then marked Secure).
# Hosts that send X-Forwarded-Proto: https (Render, Railway, Fly, most proxies) are detected automatically.
COOKIE_SECURE=false
# Set to true behind a reverse proxy so login rate limits use the real client IP.
TRUST_PROXY=false
# Serverless demo hosting only (set automatically by api/[...path].mjs on Vercel; refused when DEMO_MODE=false). Optional signing secret.
STATELESS_SESSIONS=false
SESSION_SECRET=
# Demo-only logins (shown on the demo sign-in page). Used only when DEMO_MODE=true. The server code holds no default password.
# Set your own below. If left empty, passwords are derived from SESSION_SECRET, or random and printed in the server log.
DEMO_ADMIN_EMAIL=admin@emberoak.demo
DEMO_ADMIN_PASSWORD=
DEMO_CUSTOMER_EMAIL=customer@emberoak.demo
DEMO_CUSTOMER_PASSWORD=
# Set to false to require an account to place orders (default true = guest checkout).
ALLOW_GUEST_CHECKOUT=true
# Extra browser origins allowed to call the API (comma separated). Normally empty.
ALLOWED_ORIGINS=
