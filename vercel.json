{
  "framework": null,
  "installCommand": "cd \"React Web\" && npm ci --no-audit --no-fund",
  "buildCommand": "cd \"React Web\" && npm run build",
  "outputDirectory": "React Web/dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "database/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/store",
      "destination": "/store/index.html"
    }
  ]
}
